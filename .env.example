# Copier ce fichier vers .env :  cp .env.example .env
# Le fichier .env ne doit JAMAIS être poussé sur GitHub (il est dans .gitignore).
# Ces valeurs sont pour le développement local seulement. Changez-les.

# MongoDB
MONGO_USER=mawqif
MONGO_PASSWORD=changez_moi

# Broker MQTT (Mosquitto)
MQTT_USER=mawqif
MQTT_PASSWORD=changez_moi_aussi

# Mot de passe du fichier truststore.jks (6 caractères minimum)
TRUSTSTORE_PASSWORD=changeit
