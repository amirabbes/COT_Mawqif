MONGO_USER=mawqif
MONGO_PASSWORD=changez_moi
MQTT_USER=mawqif
MQTT_PASSWORD=changez_moi_aussi
TRUSTSTORE_PASSWORD=changeit
VITE_API_URL=http://localhost:8081
# IAM (comptes et jetons). Laisser vide = valeurs de développement du docker-compose.
IAM_JWT_SECRET=changez_moi_cle_de_32_caracteres_ou_plus
IAM_SEED_ADMIN_PASSWORD=admin12345
IAM_SEED_OPERATOR_PASSWORD=operator12345
IAM_SEED_DRIVER_PASSWORD=driver12345
# Origines CORS des PWA (* = toutes, pour le réseau local de développement)
CORS_ALLOWED_ORIGINS=*
# Frontends (build) : chemin devant /v1 et /ws. /api par défaut ; vide quand l'API a son propre hôte (api.<domaine>)
# VITE_API_PREFIX=
# Mode « WildFly sert tout » (docker-compose.hosts.yml) : adresses des services baked dans les frontends
# HOSTS_API_URL=http://api.mawqif.local:8081
# HOSTS_IAM_URL=http://iam.mawqif.local:8081
